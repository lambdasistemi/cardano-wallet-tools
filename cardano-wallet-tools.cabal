cabal-version:      3.4
name:               cardano-wallet-tools
version:            0.1.0.0
synopsis:           Wallet-side UTxO, coin, and collateral selection
description:
  Pure, WASM-portable wallet-side selection for Cardano: coin selection
  and multi-UTxO, native-asset-aware collateral selection. The
  ledger-typed wrappers, trust-minimized resolution backends, operator
  CLI, and PureScript CIP-30 browser wallet build on this core.

license:            Apache-2.0
license-file:       LICENSE
author:             Paolo Veronelli
maintainer:         paolo.veronelli@gmail.com
copyright:          (c) Paolo Veronelli, 2026
category:           Cardano
build-type:         Simple
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/bundle/*.json
  test/fixtures/bundle/*.md
  test/fixtures/bundle/golden/*.hex
  test/fixtures/bundle/golden/*.skey
  test/fixtures/vault/*.md
  test/fixtures/vault/*.skey
  test/fixtures/vault/*.vkey
  test/fixtures/vault/golden/*.addr_xsk
  test/fixtures/vault/golden/*.age
  test/fixtures/vault/golden/*.hex
  test/fixtures/vault/golden/*.json
  test/fixtures/vault/golden/*.skey
  test/fixtures/vault/golden/passphrase
  test/fixtures/vault/tx-sign/*.age
  test/fixtures/vault/tx-sign/*.json
  test/fixtures/vault/tx-sign/*.skey
  test/fixtures/vault/tx-sign/*.vkey
  test/fixtures/vault/tx-sign/passphrase

flag werror
  description: Enable -Werror (used by nix builds and CI).
  manual:      True
  default:     False

common warnings
  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints -Wpartial-fields

  if flag(werror)
    ghc-options: -Werror

common language
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings

library
  import:          warnings, language
  hs-source-dirs:  lib
  exposed-modules:
    Cardano.Wallet.Tools.Cli.Fido2
    Cardano.Wallet.Tools.Cli.Vault
    Cardano.Wallet.Tools.Selection.Collateral
    Cardano.Wallet.Tools.Selection.Strategy
    Cardano.Wallet.Tools.Sign
    Cardano.Wallet.Tools.Sign.AttachWitness
    Cardano.Wallet.Tools.Sign.Witness
    Cardano.Wallet.Tools.Vault.Fido2
    Cardano.Wallet.Tools.Vault.File
    Cardano.Wallet.Tools.Vault.Passphrase
    Cardano.Wallet.Tools.Vault.Payload
    Cardano.Wallet.Tools.Vault.Plugin
    Cardano.Wallet.Tools.Vault.Scrypt

  other-modules:
    Cardano.Wallet.Tools.Vault.Plugin.Payload
    Cardano.Wallet.Tools.Vault.Plugin.Process

  build-depends:
    , aeson
    , age
    , attoparsec
    , base                  >=4.18 && <5
    , base16-bytestring
    , bech32
    , bytestring
    , containers
    , crypton
    , filepath
    , memory
    , optparse-applicative
    , process
    , text
    , transformers
    , unix

library ledger
  import:          warnings, language
  visibility:      public
  hs-source-dirs:  ledger
  exposed-modules:
    Cardano.Wallet.Tools.Ledger.Bundle
    Cardano.Wallet.Tools.Ledger.Cli.Bundle
    Cardano.Wallet.Tools.Ledger.Envelope
    Cardano.Wallet.Tools.Ledger.Submit
    Cardano.Wallet.Tools.Ledger.Witness

  build-depends:
    , aeson
    , base                   >=4.18 && <5
    , base16-bytestring
    , bech32
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-wallet-tools
    , containers
    , microlens
    , optparse-applicative
    , text

executable cwt
  import:         warnings, language
  hs-source-dirs: app
  main-is:        Main.hs
  other-modules:
    Cli.Key
    Cli.Pipe

  build-depends:
    , base
    , base16-bytestring
    , bytestring
    , cardano-wallet-tools
    , cardano-wallet-tools:ledger
    , optparse-applicative
    , text

-- Test double: speaks the age plugin protocol for the specs. The
-- package never installs it under the name of a real plugin.
executable cwt-fake-fido2-plugin
  import:         warnings, language
  hs-source-dirs: test/fake-plugin
  main-is:        Main.hs
  build-depends:
    , base        >=4.18 && <5
    , bech32
    , bytestring
    , crypton
    , memory
    , text

test-suite spec
  import:             warnings, language
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  other-modules:
    Cardano.Wallet.Tools.Cli.Fido2Spec
    Cardano.Wallet.Tools.Cli.VaultSpec
    Cardano.Wallet.Tools.Ledger.BundleSpec
    Cardano.Wallet.Tools.Ledger.Cli.BundleSpec
    Cardano.Wallet.Tools.Ledger.EnvelopeSpec
    Cardano.Wallet.Tools.Ledger.SubmitSpec
    Cardano.Wallet.Tools.Ledger.WitnessSpec
    Cardano.Wallet.Tools.Selection.CollateralSpec
    Cardano.Wallet.Tools.Selection.StrategySpec
    Cardano.Wallet.Tools.Sign.AttachWitnessSpec
    Cardano.Wallet.Tools.Sign.WitnessSpec
    Cardano.Wallet.Tools.Vault.BodyHashSpec
    Cardano.Wallet.Tools.Vault.FakePluginSpec
    Cardano.Wallet.Tools.Vault.Fido2InteropSpec
    Cardano.Wallet.Tools.Vault.Fido2Spec
    Cardano.Wallet.Tools.Vault.FileSpec
    Cardano.Wallet.Tools.Vault.InteropSpec
    Cardano.Wallet.Tools.Vault.PassphraseSpec
    Cardano.Wallet.Tools.Vault.PayloadSpec
    Cardano.Wallet.Tools.Vault.PluginSpec
    Cardano.Wallet.Tools.Vault.ScryptSpec
    Cardano.Wallet.Tools.Vault.TxSignIdentitySpec
    Support.FakePlugin
    Support.Fido2
    Support.Ledger
    Support.LedgerScenario
    Support.Vault

  build-tool-depends:
    , cardano-wallet-tools:cwt
    , cardano-wallet-tools:cwt-fake-fido2-plugin
    , hspec-discover:hspec-discover

  build-depends:
    , aeson
    , age
    , attoparsec
    , base
    , base16-bytestring
    , bech32
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-strict-containers
    , cardano-wallet-tools
    , cardano-wallet-tools:ledger
    , containers
    , crypton
    , directory
    , filepath
    , hspec
    , memory
    , microlens
    , optparse-applicative
    , process
    , QuickCheck
    , text
    , transformers
    , unix
    , vector
